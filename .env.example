# ScraperAPI key used by the rankings scraper (server-side only).
# Get one at https://www.scraperapi.com/
SCRAPER_API_KEY=your-scraperapi-key

# Canonical site URL used for SEO (sitemap, robots, canonical, Open Graph).
# Set this in Vercel project settings once the production domain exists.
# Falls back to https://baseline-tennis.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to serve the bundled mock standings instead of scraping.
# Useful for UI work without burning ScraperAPI credits. Any other value
# (or unset) uses the real scraper.
NEXT_PUBLIC_USE_MOCK_DATA=false
